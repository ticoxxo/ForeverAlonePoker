    "Online matches against other signed-in players count toward the world and country leaderboards." : {
      "comment" : "A description of the benefits of being signed into ranked play.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب المباريات عبر الإنترنت ضد لاعبين آخرين مسجّلين الدخول في لوحتي الصدارة العالمية والخاصة بالدولة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online zápasy proti dalším přihlášeným hráčům se započítávají do světového a národního žebříčku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online-Partien gegen andere angemeldete Spieler zählen für die Welt- und Länderbestenlisten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juegos online en contra otros jugadores ranked cuentan hacia el ranking mundial y de tu país."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les parties en ligne contre d’autres joueurs connectés comptent pour les classements mondial et national."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משחקים מקוונים מול שחקנים מחוברים אחרים נספרים בטבלאות המובילים העולמית והארצית."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partite online contro altri giocatori che hanno effettuato l’accesso contano per le classifiche mondiale e nazionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしている他のプレイヤーとのオンライン対戦は、世界と国別のランキングに反映されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online partijen tegen andere ingelogde spelers tellen mee voor de wereld- en landranglijsten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partidas online contra outros jogadores conectados contam para as classificações mundial e do país."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與其他已登入玩家的線上對局會計入全球及國家或地區排行榜。"
          }
        }
      }
    },
    "Only if their device already has that skin. Otherwise they see the classic cards." : {
      "comment" : "FAQ question about whether opponents can see the cards' skins.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط إذا كان جهازه يحتوي على هذا المظهر بالفعل. وإلا فسيرى الأوراق الكلاسيكية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen pokud jeho zařízení už tento skin má. Jinak uvidí klasické karty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn sein Gerät diesen Skin bereits hat. Sonst sieht er die klassischen Karten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si tu dispositivo ya tiene ese skin. Sino ellos mirarán las cartas clásicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement si son appareil possède déjà ce skin. Sinon, il voit les cartes classiques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק אם העיצוב כבר נמצא במכשיר שלו. אחרת הוא יראה את הקלפים הקלאסיים."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se il suo dispositivo ha già quella skin. Altrimenti vede le carte classiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のデバイスにそのスキンがある場合のみです。ない場合はクラシックカードが表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen als zijn apparaat die skin al heeft. Anders ziet hij de klassieke kaarten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente se o dispositivo dele já tiver essa skin. Caso contrário, ele vê as cartas clássicas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在對方的裝置已有該外觀時才看得到，否則會看到經典牌面。"
          }
        }
      }
    },
    "Open Help, then Request a Refund, and choose the purchase. Apple handles the request and emails you about it." : {
      "comment" : "Text displayed in a list item in the FAQ view for requesting a refund.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح المساعدة، ثم طلب استرداد المبلغ، واختر عملية الشراء. تتولى Apple الطلب وترسل إليك بريدًا إلكترونيًا بشأنه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete Nápovědu, pak Požádat o vrácení peněz a vyberte nákup. Žádost vyřídí Apple a pošle vám o ní e-mail."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne „Hilfe“, dann „Rückerstattung anfordern“ und wähle den Kauf aus. Apple bearbeitet die Anfrage und benachrichtigt dich per E-Mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ayuda, después Pedir un Reembolso y elige la compra. Apple se encarga de la solicitud y te manda un email."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Aide, puis Demander un remboursement, et choisissez l’achat. Apple traite la demande et vous envoie un e-mail à ce sujet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתחו את ״עזרה״, אחר כך ״בקשת החזר כספי״, ובחרו את הרכישה. Apple מטפלת בבקשה ושולחת לכם דוא״ל בנושא."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Aiuto, poi Richiedi un rimborso, e scegli l’acquisto. Apple gestisce la richiesta e ti invia un’e-mail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ヘルプ」を開き、「返金をリクエスト」を選んで購入を選択してください。Appleがリクエストを処理し、メールでお知らせします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Help, daarna Vraag een terugbetaling aan, en kies de aankoop. Apple handelt het verzoek af en mailt je erover."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Ajuda, depois Solicitar Reembolso, e escolha a compra. A Apple cuida da solicitação e envia um e-mail sobre ela."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開「說明」，再點一下「申請退款」，然後選擇購買項目。Apple 會處理申請並寄電子郵件通知你。"
          }
        }
      }
    },
