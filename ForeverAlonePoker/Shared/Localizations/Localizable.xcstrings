    "Card faces and backs belong to the Apple Account that bought them and appear on every device signed in with it." : {
      "comment" : "A description of how the cards are tied to the user's Apple account.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتمي واجهات الأوراق وظهورها إلى حساب Apple الذي اشتراها، وتظهر على كل جهاز مسجّل الدخول به."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líce a rubové strany karet patří Apple účtu, kterým byly zakoupeny, a zobrazí se na každém zařízení, které je k němu přihlášené."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartenvorder- und -rückseiten gehören zum Apple Account, mit dem sie gekauft wurden, und erscheinen auf jedem damit angemeldeten Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara y dorsal de las cartas pertenece a la cuenta de Apple que las compró y aparecen en cada dispositivo que inicio sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les faces et dos de cartes appartiennent au compte Apple qui les a achetés et apparaissent sur tous les appareils connectés à ce compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חזיתות וגבי קלפים שייכים לחשבון Apple שרכש אותם ומופיעים בכל מכשיר שמחובר אליו."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fronti e dorsi delle carte appartengono all’Account Apple che li ha acquistati e compaiono su ogni dispositivo che ha effettuato l’accesso con quell’account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードの表面と裏面は購入したAppleアカウントに紐づき、そのアカウントでサインインしているすべてのデバイスに表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaartvoorkanten en -ruggen horen bij het Apple Account waarmee ze zijn gekocht en verschijnen op elk apparaat dat daarmee is ingelogd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
