    "Your profile and history are stored on this device. Sign into iCloud in Settings to sync them, and sign in with Apple to play ranked matches." : {
      "comment" : "A description of the user's tier.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تخزين ملفك الشخصي وسجلك على هذا الجهاز. سجّل الدخول إلى iCloud في الإعدادات لمزامنتهما، وسجّل الدخول باستخدام Apple للعب مباريات مصنفة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš profil a historie jsou uložené v tomto zařízení. Pro synchronizaci se přihlaste k iCloudu v Nastavení a pro hraní hodnocených zápasů se přihlaste přes Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profil und Verlauf sind auf diesem Gerät gespeichert. Melde dich in den Einstellungen bei iCloud an, um sie zu synchronisieren, und mit Apple, um gewertete Partien zu spielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu perfil e historial son guardados en este dispositivo. Inicia sesión en iCloud en Configuración para sincronizarlos, inicia sesión con Apple para jugar juegos en ranked."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil et votre historique sont stockés sur cet appareil. Connectez-vous à iCloud dans Réglages pour les synchroniser, et connectez-vous avec Apple pour jouer des parties classées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפרופיל וההיסטוריה שלך שמורים במכשיר הזה. התחברו ל־iCloud בהגדרות כדי לסנכרן אותם, והתחברו עם Apple כדי לשחק משחקים מדורגים."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo profilo e la cronologia sono salvati su questo dispositivo. Accedi a iCloud in Impostazioni per sincronizzarli e accedi con Apple per giocare partite classificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールと履歴はこのデバイスに保存されています。同期するには「設定」でiCloudにサインインし、ランク戦をプレイするにはAppleでサインインしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je profiel en geschiedenis worden op dit apparaat bewaard. Log in bij iCloud in Instellingen om ze te synchroniseren, en log in met Apple om rankedpartijen te spelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu perfil e histórico ficam armazenados neste dispositivo. Inicie sessão no iCloud em Ajustes para sincronizá-los e inicie sessão com a Apple para jogar partidas ranqueadas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的個人檔案與紀錄儲存在此裝置上。請在「設定」中登入 iCloud 以同步，並透過 Apple 登入以進行排名賽。"
          }
        }
      }
    },
    "Your profile and history sync through iCloud. Sign in with Apple to play ranked matches and appear on the leaderboard." : {
      "comment" : "A description of the user's tier.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مزامنة ملفك الشخصي وسجلك عبر iCloud. سجّل الدخول باستخدام Apple للعب مباريات مصنفة والظهور في لوحة الصدارة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš profil a historie se synchronizují přes iCloud. Přihlaste se přes Apple, abyste mohli hrát hodnocené zápasy a objevit se v žebříčku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profil und Verlauf werden über iCloud synchronisiert. Melde dich mit Apple an, um gewertete Partien zu spielen und in der Bestenliste zu erscheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu perfil e historial sincronizado con iCloud. Inicia sesión con Apple para jugar ranked y aparecer en el leaderboard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil et votre historique se synchronisent via iCloud. Connectez-vous avec Apple pour jouer des parties classées et apparaître dans le classement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפרופיל וההיסטוריה שלך מסונכרנים דרך iCloud. התחברו עם Apple כדי לשחק משחקים מדורגים ולהופיע בטבלת המובילים."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo profilo e la cronologia si sincronizzano tramite iCloud. Accedi con Apple per giocare partite classificate e comparire in classifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールと履歴はiCloudで同期されます。Appleでサインインすると、ランク戦をプレイしてランキングに表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je profiel en geschiedenis worden via iCloud gesynchroniseerd. Log in met Apple om rankedpartijen te spelen en op de ranglijst te verschijnen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu perfil e histórico são sincronizados pelo iCloud. Inicie sessão com a Apple para jogar partidas ranqueadas e aparecer na classificação."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的個人檔案與紀錄會透過 iCloud 同步。透過 Apple 登入即可進行排名賽並出現在排行榜上。"
          }
        }
      }
    },
