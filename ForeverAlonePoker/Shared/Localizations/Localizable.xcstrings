    "Purchases are turned off on this device (Screen Time or parental controls). You can still use skins you already own." : {
      "comment" : "A description of the store's inability to make payments.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمليات الشراء متوقفة على هذا الجهاز (مدة استخدام الجهاز أو الرقابة الأبوية). لا يزال بإمكانك استخدام المظاهر التي تملكها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákupy jsou v tomto zařízení vypnuté (Čas u obrazovky nebo rodičovská kontrola). Skiny, které už vlastníte, můžete používat dál."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käufe sind auf diesem Gerät deaktiviert (Bildschirmzeit oder Kindersicherung). Skins, die du bereits besitzt, kannst du weiterhin verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compras están deshabilitadas en este dispositivos (Screen Time o control parental). Aún puedes usar skins previamente adquiridos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats sont désactivés sur cet appareil (Temps d’écran ou contrôle parental). Vous pouvez toujours utiliser les skins que vous possédez déjà."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרכישות כבויות במכשיר הזה (זמן מסך או בקרת הורים). עדיין אפשר להשתמש בעיצובים שכבר בבעלותכם."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli acquisti sono disattivati su questo dispositivo (Tempo di utilizzo o controlli parentali). Puoi comunque usare le skin che possiedi già."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは購入がオフになっています（スクリーンタイムまたはペアレンタルコントロール）。すでに持っているスキンは引き続き使えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aankopen zijn uitgeschakeld op dit apparaat (Schermtijd of ouderlijk toezicht). Je kunt skins die je al hebt nog steeds gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As compras estão desativadas neste dispositivo (Tempo de Uso ou controles parentais). Você ainda pode usar as skins que já tem."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置已關閉購買功能（螢幕使用時間或分級保護控制）。你仍可使用已擁有的外觀。"
          }
        }
      }
    },
