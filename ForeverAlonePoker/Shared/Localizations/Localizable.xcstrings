    "Downloaded art can take a moment to appear. Until then the classic cards show." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تستغرق الرسومات التي تم تنزيلها لحظة لتظهر. حتى ذلك الحين تظهر الأوراق الكلاسيكية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažená grafika se může chvíli načítat. Do té doby se zobrazují klasické karty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heruntergeladene Grafiken können einen Moment brauchen. Bis dahin werden die klassischen Karten angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arte descargado puede tomar un momento en aparecer. Hasta entonces se mostrará las cartas clásicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les illustrations téléchargées peuvent mettre un moment à apparaître. En attendant, les cartes classiques s’affichent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייתכן שיעבור רגע עד שהעיצוב שהורד יופיע. עד אז יוצגו הקלפים הקלאסיים."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grafica scaricata può richiedere un momento per comparire. Nel frattempo vengono mostrate le carte classiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアートは表示されるまで少し時間がかかることがあります。それまではクラシックカードが表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedownloade afbeeldingen kunnen even nodig hebben. Tot die tijd worden de klassieke kaarten getoond."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As artes baixadas podem levar um momento para aparecer. Até lá, as cartas clássicas são exibidas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的圖案可能需要一點時間才會出現，在此之前會顯示經典牌面。"
          }
        }
      }
    },
