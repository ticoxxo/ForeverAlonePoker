    "Start whenever you like. Players still connecting get a few seconds to sit down." : {
      "comment" : "A description of the lobby screen when the game is not starting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ متى شئت. يحصل اللاعبون الذين ما زالوا يتصلون على بضع ثوانٍ للجلوس."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte, kdy chcete. Hráči, kteří se ještě připojují, dostanou pár sekund, aby si sedli."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte, wann du willst. Spieler, die sich noch verbinden, haben ein paar Sekunden, um Platz zu nehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comienza cuando quieras. Jugadores aún conectando obtienen unos pocos segundos para sentarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez quand vous voulez. Les joueurs encore en cours de connexion ont quelques secondes pour s’installer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחילו מתי שתרצו. שחקנים שעדיין מתחברים יקבלו כמה שניות להתיישב."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia quando vuoi. I giocatori ancora in connessione hanno qualche secondo per sedersi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きなときに開始できます。接続中のプレイヤーには着席のために数秒の猶予があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin wanneer je wilt. Spelers die nog verbinden krijgen een paar seconden om te gaan zitten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece quando quiser. Jogadores ainda conectando têm alguns segundos para se sentar."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨時都能開始，仍在連線的玩家會有幾秒鐘入座。"
          }
        }
      }
    },
    "Starting…" : {
      "comment" : "Text displayed in a lobby when the game is starting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
