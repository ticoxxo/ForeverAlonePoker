<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_fapoker._tcp</string>
		<string>_fapoker._udp</string>
	</array>
	<key>SkinCatalogPublicKeys</key>
	<!-- Key id to base64 Ed25519 public key of the skin catalog publisher
	     (tdr/0012; `swift run --package-path Server SkinPublisher keygen`).
	     Release builds refuse catalogs not signed by one of these; debug builds
	     with none pinned accept an unsigned development server. -->
	<dict/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
